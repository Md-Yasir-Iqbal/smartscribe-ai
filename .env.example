# SmartScribe AI — environment variables
#
# Copy this file to ".env" in the project root and fill in your own values:
#     cp .env.example .env        (macOS/Linux)
#     copy .env.example .env      (Windows)
#
# Never commit your real ".env" file — it is already excluded in .gitignore.

# Your Google Gemini API key.
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The Gemini model SmartScribe AI should use for summarization.
# See README.md ("Environment Variables") for current model name guidance.
GEMINI_MODEL=gemini-3.5-flash

